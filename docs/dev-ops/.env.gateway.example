# Copy to .env.gateway on the deployment host and replace placeholders.
# This file is intentionally excluded from version control.
GATEWAY_CONTAINER=ai-mcp-gateway
GATEWAY_IMAGE=ai-mcp-gateway
GATEWAY_HOST_PORT=8797
GATEWAY_CONTAINER_PORT=8797
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_NETWORK=
GATEWAY_HEALTH_PATH=/api-gateway/admin/query_gateway_config_list
# Optional when running the script on the production host.
# GATEWAY_SOURCE_ROOT=/home/ubuntu/gw-build
# GATEWAY_BUILD_CONTEXT=/home/ubuntu/gw-build/ai-mcp-gateway-app
# Optional when Maven is unavailable: path to a prebuilt application JAR.
# GATEWAY_JAR=/home/ubuntu/gw-deploy/ai-mcp-gateway-app.new.jar
GATEWAY_HEALTH_TIMEOUT=120
SPRING_PROFILES_ACTIVE=dev
MCP_CONSOLE_ADMIN_USERNAME=admin
MCP_CONSOLE_ADMIN_PASSWORD=replace-me
SERVER_PORT=8797
MCP_CONTROL_DB_PASSWORD=replace-me
MCP_MYSQL_DATASOURCE_KEY=replace-me
OPENAI_API_KEY=replace-me
MCP_REDIS_HOST=redis
MCP_REDIS_PORT=6379
MCP_REDIS_PASSWORD=replace-me

# Full-stack deployment settings. These paths match the production host but
# can be overridden when the deployment bundle is stored elsewhere.
NGINX_CONTAINER=ai-mcp-gateway-nginx
NGINX_ROOT=/opt/ai-mcp-gateway/nginx/html
MYSQL_CONTAINER=mysql
MYSQL_DATABASE=ai_mcp_gateway_v2
PUBLIC_BASE_URL=http://127.0.0.1:8088
