<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.ai.infrastructure.dao.IMcpProtocolMysqlDao">

    <resultMap id="McpProtocolMysqlMap" type="cn.bugstack.ai.infrastructure.dao.po.McpProtocolMysqlPO">
        <id column="id" property="id"/>
        <result column="protocol_id" property="protocolId"/>
        <result column="datasource_id" property="datasourceId"/>
        <result column="sql_text" property="sqlText"/>
        <result column="max_rows" property="maxRows"/>
        <result column="max_result_bytes" property="maxResultBytes"/>
        <result column="max_columns" property="maxColumns"/>
        <result column="timeout_ms" property="timeoutMs"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="MysqlProtocolColumns">
        id, protocol_id, datasource_id, sql_text, max_rows, max_result_bytes,
        max_columns, timeout_ms, status, create_time, update_time
    </sql>

    <insert id="insert" parameterType="cn.bugstack.ai.infrastructure.dao.po.McpProtocolMysqlPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mcp_protocol_mysql
        (protocol_id, datasource_id, sql_text, max_rows, max_result_bytes,
         max_columns, timeout_ms, status)
        VALUES
        (#{protocolId}, #{datasourceId}, #{sqlText}, #{maxRows}, #{maxResultBytes},
         #{maxColumns}, #{timeoutMs}, COALESCE(#{status}, 0))
    </insert>

    <update id="updateByProtocolId" parameterType="cn.bugstack.ai.infrastructure.dao.po.McpProtocolMysqlPO">
        UPDATE mcp_protocol_mysql
        SET datasource_id = #{datasourceId},
            sql_text = #{sqlText},
            max_rows = #{maxRows},
            max_result_bytes = #{maxResultBytes},
            max_columns = #{maxColumns},
            timeout_ms = #{timeoutMs},
            status = #{status},
            update_time = CURRENT_TIMESTAMP
        WHERE protocol_id = #{protocolId}
    </update>

    <delete id="deleteByProtocolId" parameterType="java.lang.Long">
        DELETE FROM mcp_protocol_mysql WHERE protocol_id = #{protocolId}
    </delete>

    <select id="queryById" parameterType="java.lang.Long" resultMap="McpProtocolMysqlMap">
        SELECT <include refid="MysqlProtocolColumns"/>
        FROM mcp_protocol_mysql
        WHERE id = #{id}
    </select>

    <select id="queryByProtocolId" parameterType="java.lang.Long" resultMap="McpProtocolMysqlMap">
        SELECT <include refid="MysqlProtocolColumns"/>
        FROM mcp_protocol_mysql
        WHERE protocol_id = #{protocolId}
    </select>

    <select id="queryEnabledByProtocolId" parameterType="java.lang.Long" resultMap="McpProtocolMysqlMap">
        SELECT <include refid="MysqlProtocolColumns"/>
        FROM mcp_protocol_mysql
        WHERE protocol_id = #{protocolId} AND status = 1
    </select>

    <select id="queryListByDatasourceId" parameterType="java.lang.Long" resultMap="McpProtocolMysqlMap">
        SELECT <include refid="MysqlProtocolColumns"/>
        FROM mcp_protocol_mysql
        WHERE datasource_id = #{datasourceId}
        ORDER BY id DESC
    </select>

    <select id="queryAll" resultMap="McpProtocolMysqlMap">
        SELECT <include refid="MysqlProtocolColumns"/>
        FROM mcp_protocol_mysql
        ORDER BY id DESC
    </select>

</mapper>
