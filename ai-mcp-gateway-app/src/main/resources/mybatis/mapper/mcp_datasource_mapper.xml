<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.ai.infrastructure.dao.IMcpDataSourceDao">

    <resultMap id="McpDataSourceMap" type="cn.bugstack.ai.infrastructure.dao.po.McpDataSourcePO">
        <id column="id" property="id"/>
        <result column="datasource_ref" property="datasourceRef"/>
        <result column="datasource_name" property="datasourceName"/>
        <result column="datasource_type" property="datasourceType"/>
        <result column="jdbc_url" property="jdbcUrl"/>
        <result column="username" property="username"/>
        <result column="password_ciphertext" property="passwordCiphertext"/>
        <result column="password_nonce" property="passwordNonce"/>
        <result column="encryption_key_ref" property="encryptionKeyRef"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="DataSourceColumns">
        id, datasource_ref, datasource_name, datasource_type, jdbc_url, username,
        password_ciphertext, password_nonce, encryption_key_ref, status, create_time, update_time
    </sql>

    <insert id="insert" parameterType="cn.bugstack.ai.infrastructure.dao.po.McpDataSourcePO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mcp_datasource
        (datasource_ref, datasource_name, datasource_type, jdbc_url, username,
         password_ciphertext, password_nonce, encryption_key_ref, status)
        VALUES
        (#{datasourceRef}, #{datasourceName}, #{datasourceType}, #{jdbcUrl}, #{username},
         #{passwordCiphertext}, #{passwordNonce}, #{encryptionKeyRef}, COALESCE(#{status}, 0))
    </insert>

    <update id="updateById" parameterType="cn.bugstack.ai.infrastructure.dao.po.McpDataSourcePO">
        UPDATE mcp_datasource
        SET datasource_ref = #{datasourceRef},
            datasource_name = #{datasourceName},
            datasource_type = #{datasourceType},
            jdbc_url = #{jdbcUrl},
            username = #{username},
            password_ciphertext = #{passwordCiphertext},
            password_nonce = #{passwordNonce},
            encryption_key_ref = #{encryptionKeyRef},
            status = #{status},
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="deleteByDatasourceRef" parameterType="java.lang.String">
        DELETE FROM mcp_datasource WHERE datasource_ref = #{datasourceRef}
    </delete>

    <select id="queryById" parameterType="java.lang.Long" resultMap="McpDataSourceMap">
        SELECT <include refid="DataSourceColumns"/>
        FROM mcp_datasource
        WHERE id = #{id}
    </select>

    <select id="queryByDatasourceRef" parameterType="java.lang.String" resultMap="McpDataSourceMap">
        SELECT <include refid="DataSourceColumns"/>
        FROM mcp_datasource
        WHERE datasource_ref = #{datasourceRef}
    </select>

    <select id="queryEnabledByDatasourceRef" parameterType="java.lang.String" resultMap="McpDataSourceMap">
        SELECT <include refid="DataSourceColumns"/>
        FROM mcp_datasource
        WHERE datasource_ref = #{datasourceRef} AND status = 1
    </select>

    <select id="queryAll" resultMap="McpDataSourceMap">
        SELECT <include refid="DataSourceColumns"/>
        FROM mcp_datasource
        ORDER BY id DESC
    </select>

</mapper>
